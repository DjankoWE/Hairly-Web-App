@using Hairly.Web.ViewModels.Review;

@model IEnumerable<ReviewIndexViewModel>

@{
    ViewData["Title"] = "Reviews";
}

<div class="container mt-4">
	@if (TempData["SuccessMessage"] != null)
	{
		<div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
			<i class="bi bi-check-circle-fill me-2"></i>
			@TempData["SuccessMessage"]
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}

	@if (TempData["ErrorMessage"] != null)
	{
		<div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
			<i class="bi bi-exclamation-triangle-fill me-2"></i>
			@TempData["ErrorMessage"]
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}

	<div class="d-flex justify-content-between align-items-center mb-4">
		<h2><i class="bi bi-star-fill text-warning"></i> Customer Reviews</h2>
	</div>

	@if (!Model.Any())
	{
		<div class="alert alert-info">
			<i class="bi bi-info-circle"></i> No reviews yet. Be the first to leave a review!
		</div>
	}
	else
	{
		<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
			@foreach (var review in Model)
			{
				<div class="col">
					<div class="card h-100">
						<div class="card-header bg-light">
							<div class="d-flex justify-content-between align-items-center">
								<div>
									@for (int i = 1; i <= 5; i++)
									{
										if (i <= review.Rating)
										{
											<i class="bi bi-star-fill text-warning"></i>
										}
										else
										{
											<i class="bi bi-star text-muted"></i>
										}
									}
									<span class="ms-2 fw-bold">@review.Rating/5</span>
								</div>
								<small class="text-muted">@review.CreatedOn.ToString("dd/MM/yyyy")</small>
							</div>
						</div>
						<div class="card-body">
							@if (!string.IsNullOrWhiteSpace(review.Comment))
							{
								<p class="card-text">"@review.Comment"</p>
							}
							else
							{
								<p class="card-text text-muted fst-italic">No comment provided.</p>
							}
						</div>
						<div class="card-footer bg-white">
							<div class="small">
								<div class="mb-1">
									<i class="bi bi-person-fill text-primary"></i>
									<strong>Client:</strong> @review.ClientName
								</div>
								<div class="mb-1">
									<i class="bi bi-scissors text-success"></i>
									<strong>Hairdresser:</strong> @review.HairdresserName
								</div>
								<div class="mb-2">
									<i class="bi bi-briefcase text-info"></i>
									<strong>Service:</strong> @review.ServiceName
								</div>
								<div class="d-flex gap-2">
									<a asp-action="Details" asp-route-id="@review.Id" class="btn btn-sm btn-outline-primary">
										<i class="bi bi-eye"></i> Details
									</a>

									@if (User.Identity?.IsAuthenticated ?? false)
									{
										@if (User.IsInRole("Admin"))
										{
											<a asp-action="Delete" asp-route-id="@review.Id" class="btn btn-sm btn-outline-danger">
												<i class="bi bi-trash"></i> Delete
											</a>
										}
									}
								</div>
							</div>
						</div>
					</div>
				</div>
			}
		</div>
	}
</div>
