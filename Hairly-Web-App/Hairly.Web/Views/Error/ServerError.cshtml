@{
    ViewData["Title"] = "500 - Server Error";
}

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-8 text-center">
            <div class="error-page">
                <div class="error-icon mb-4">
                    <i class="bi bi-exclamation-octagon-fill text-danger" style="font-size: 8rem;"></i>
                </div>

                <h1 class="display-1 fw-bold text-danger">500</h1>
                <h2 class="mb-4">@ViewData["ErrorTitle"]</h2>
                <p class="lead text-muted mb-4">
                    @ViewData["ErrorMessage"]
                </p>

                <div class="alert alert-warning d-inline-block mb-4" role="alert">
                    <i class="bi bi-info-circle me-2"></i>
                    Our team has been notified and is working to fix the issue.
                </div>

                <div class="error-suggestions mb-5">
                    <p class="text-muted">What you can do:</p>
                    <div class="d-flex justify-content-center gap-3 flex-wrap">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-danger">
                            <i class="bi bi-house-door"></i> Go Home
                        </a>
                        <button onclick="window.location.reload()" class="btn btn-outline-danger">
                            <i class="bi bi-arrow-clockwise"></i> Try Again
                        </button>
                        <button onclick="window.history.back()" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Go Back
                        </button>
                    </div>
                </div>

                <div class="error-details mt-4">
                    <details class="text-start">
                        <summary class="text-muted" style="cursor: pointer;">
                            <small>Technical Details</small>
                        </summary>
                        <div class="mt-3 p-3 bg-light rounded">
                            <small class="text-muted">
                                <strong>Status Code:</strong> @ViewData["StatusCode"]<br />
                                <strong>Timestamp:</strong> @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss UTC")<br />
                                <strong>Request Path:</strong> @Context.Request.Path
                            </small>
                        </div>
                    </details>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .error-page {
        padding: 3rem 0;
    }

    .error-icon i {
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0.6;
        }
    }

    details summary {
        transition: color 0.3s ease;
    }

        details summary:hover {
            color: #dc3545 !important;
        }
</style>
