@{
    ViewData["Title"] = "404 - Page Not Found";
}

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-8 text-center">
            <div class="error-page">
                <div class="error-icon mb-4">
                    <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 8rem;"></i>
                </div>

                <h1 class="display-1 fw-bold text-primary">404</h1>
                <h2 class="mb-4">Page Not Found</h2>
                <p class="lead text-muted mb-4">
                    The page you are looking for doesn't exist.
                </p>

                <div class="error-suggestions mb-5">
                    <p class="text-muted">Here are some helpful links instead:</p>
                    <div class="d-flex justify-content-center gap-3 flex-wrap">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                            <i class="bi bi-house-door"></i> Go Home
                        </a>
                        <a asp-controller="Review" asp-action="Index" class="btn btn-outline-primary">
                            <i class="bi bi-star"></i> View Reviews
                        </a>
                        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary">
                            <i class="bi bi-bag"></i> Browse Products
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .error-page {
        padding: 3rem 0;
    }

    .error-icon i {
        animation: bounce 2s infinite;
    }

    @@keyframes bounce {
        0%, 20%, 50%, 80%, 100% {
            transform: translateY(0);
        }

        40% {
            transform: translateY(-20px);
        }

        60% {
            transform: translateY(-10px);
        }
    }
</style>
