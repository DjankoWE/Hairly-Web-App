@{
    ViewData["Title"] = "Error";
}

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-8 text-center">
            <div class="error-page">
                <div class="error-icon mb-4">
                    <i class="bi bi-exclamation-circle-fill text-secondary" style="font-size: 8rem;"></i>
                </div>

                <h1 class="display-3 fw-bold text-secondary">Oops!</h1>
                <h2 class="mb-4">Something Went Wrong</h2>
                <p class="lead text-muted mb-4">
                    We encountered an unexpected error while processing your request.
                </p>

                <div class="alert alert-secondary d-inline-block mb-4" role="alert">
                    <i class="bi bi-info-circle me-2"></i>
                    Don't worry, you can try one of the options below.
                </div>

                <div class="error-suggestions mb-5">
                    <div class="d-flex justify-content-center gap-3 flex-wrap">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-house-door"></i> Go Home
                        </a>
                        <button onclick="window.location.reload()" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-clockwise"></i> Refresh Page
                        </button>
                        <button onclick="window.history.back()" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Go Back
                        </button>
                    </div>
                </div>

                <div class="error-help mt-5">
                    <p class="text-muted small">
                        If this problem persists, please contact our support team.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .error-page {
        padding: 3rem 0;
    }

    .error-icon i {
        animation: fadeIn 1s;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: scale(0.5);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }
</style>
